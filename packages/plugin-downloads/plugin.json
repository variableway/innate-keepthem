{
  "id": "vytdl.plugin.downloads",
  "name": "Downloads Workbench",
  "version": "1.0.0",
  "engine": "^1",
  "entry": "./src/index.tsx",
  "slots": [
    {
      "slot": "nav",
      "order": 20
    },
    {
      "slot": "page",
      "route": "/"
    },
    {
      "slot": "downloads.form-tab",
      "order": 10
    }
  ],
  "permissions": [
    "api:downloads",
    "api:settings",
    "api:metadata",
    "api:media",
    "shell:reveal-folder"
  ]
}
